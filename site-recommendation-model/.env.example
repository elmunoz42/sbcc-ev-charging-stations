# Existing server-only key for street_view_collector.py.
google_maps_street_view_api=YOUR_STREET_VIEW_KEY

# Optional browser-visible key for the dashboard's embedded Google map.
# Enable Maps JavaScript API and restrict this key to your HTTP referrers.
# Local example referrers: http://127.0.0.1:5000/* and http://localhost:5000/*
GOOGLE_MAPS_BROWSER_API_KEY=YOUR_BROWSER_MAPS_KEY
